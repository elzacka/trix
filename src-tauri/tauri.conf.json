{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trix Universal",
  "identifier": "no.tazk.trix-universal",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main", "create": false, "title": "Trix", "width": 420, "height": 600, "visible": false,
        "decorations": false, "resizable": false, "skipTaskbar": true, "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
