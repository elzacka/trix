{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The panel: content, its own settings and opening «Tilpass»",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-load",
    "allow-read-content",
    "allow-system-list",
    "allow-save",
    "allow-reveal-file",
    "allow-open-guide",
    "allow-open-url",
    "allow-set-hotkey",
    "allow-set-view",
    "allow-set-tray",
    "allow-set-size",
    "allow-set-tray-icon",
    "allow-read-icon",
    "allow-export-content",
    "allow-hold",
    "allow-hide",
    "allow-quit",
    "allow-set-mode",
    "allow-set-app-icon",
    "allow-open-setup"
  ]
}
